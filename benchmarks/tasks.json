{
  "version": "1.0",
  "tasks": [
    {
      "id": "c01",
      "title": "Balanced brackets",
      "problem": "Write a complete Python 3 program that reads one line containing (), [], and {} and prints True if brackets are balanced and properly nested, otherwise False.",
      "feedback_tests": [
        {
          "input": "([]{})\n",
          "expected_output": "True"
        },
        {
          "input": "([)]\n",
          "expected_output": "False"
        }
      ],
      "eval_tests": [
        {
          "input": "(([[{{}}]]))\n",
          "expected_output": "True"
        },
        {
          "input": "}{\n",
          "expected_output": "False"
        },
        {
          "input": "[(])\n",
          "expected_output": "False"
        }
      ]
    },
    {
      "id": "c02",
      "title": "Second largest distinct",
      "problem": "Read n and then n integers. Print the second-largest distinct integer. Assume at least two distinct values exist.",
      "feedback_tests": [
        {
          "input": "5\n1 5 3 5 2\n",
          "expected_output": "3"
        },
        {
          "input": "6\n10 10 9 8 8 7\n",
          "expected_output": "9"
        }
      ],
      "eval_tests": [
        {
          "input": "7\n4 4 4 9 2 9 7\n",
          "expected_output": "7"
        },
        {
          "input": "5\n-1 -5 -1 -2 -3\n",
          "expected_output": "-2"
        },
        {
          "input": "8\n100 50 75 100 25 75 60 60\n",
          "expected_output": "75"
        }
      ]
    },
    {
      "id": "c03",
      "title": "Merge intervals",
      "problem": "Read n followed by n lines l r. Merge overlapping or touching intervals and print merged intervals in increasing order, one per line.",
      "feedback_tests": [
        {
          "input": "4\n1 3\n2 6\n8 10\n9 12\n",
          "expected_output": "1 6\n8 12"
        },
        {
          "input": "3\n1 2\n3 5\n7 8\n",
          "expected_output": "1 5\n7 8"
        }
      ],
      "eval_tests": [
        {
          "input": "0\n",
          "expected_output": ""
        },
        {
          "input": "5\n0 2\n2 4\n10 12\n11 15\n20 21\n",
          "expected_output": "0 4\n10 15\n20 21"
        },
        {
          "input": "4\n-5 -1\n-3 2\n4 4\n5 7\n",
          "expected_output": "-5 2\n4 7"
        }
      ]
    },
    {
      "id": "c04",
      "title": "Prime sum",
      "problem": "Read an integer n and print the sum of all primes p with 2 <= p <= n. Print 0 for n < 2.",
      "feedback_tests": [
        {
          "input": "10\n",
          "expected_output": "17"
        },
        {
          "input": "1\n",
          "expected_output": "0"
        }
      ],
      "eval_tests": [
        {
          "input": "2\n",
          "expected_output": "2"
        },
        {
          "input": "20\n",
          "expected_output": "77"
        },
        {
          "input": "30\n",
          "expected_output": "129"
        }
      ]
    },
    {
      "id": "c05",
      "title": "Matrix transpose",
      "problem": "Read r and c followed by r rows of c integers. Print the transpose as c rows of r integers.",
      "feedback_tests": [
        {
          "input": "2 3\n1 2 3\n4 5 6\n",
          "expected_output": "1 4\n2 5\n3 6"
        },
        {
          "input": "1 4\n7 8 9 10\n",
          "expected_output": "7\n8\n9\n10"
        }
      ],
      "eval_tests": [
        {
          "input": "3 1\n5\n6\n7\n",
          "expected_output": "5 6 7"
        },
        {
          "input": "2 2\n-1 0\n8 3\n",
          "expected_output": "-1 8\n0 3"
        },
        {
          "input": "3 2\n1 2\n3 4\n5 6\n",
          "expected_output": "1 3 5\n2 4 6"
        }
      ]
    }
  ]
}